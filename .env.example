# Copy this file to .env (repo root) and fill in your actual Supabase project
# values. NEVER commit the real .env file — it is already excluded via
# .gitignore. See backend/README.md for where to find these in the Supabase
# dashboard.

SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Direct Postgres connection string (Project Settings -> Database -> Connection
# string). Only needed if applying database/schema.sql via `psql`, rather than
# pasting it into the Supabase SQL Editor.
DATABASE_URL=

# Comma-separated list of allowed frontend origins for CORS. Defaults to local
# dev ports if unset — override for a deployed frontend.
# FRONTEND_ORIGINS=http://localhost:3000,http://localhost:5173
